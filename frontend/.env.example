# Homigo Frontend (Vite)
# Copy to frontend/.env.local (or set in Vercel env vars).

# Backend API base URL
# Local default: http://localhost:4000/api
VITE_API_BASE_URL=http://localhost:4000/api

# Optional (recommended in production): Clerk publishable key
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: demo mode fallback user id when Clerk is disabled
VITE_DEMO_USER_ID=1
